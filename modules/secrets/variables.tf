variable "environment" {
  description = "Environment name, used as a resource name prefix."
  type        = string
}

variable "region" {
  description = "The only region that holds secret replicas."
  type        = string
}

variable "generated_secrets" {
  description = "Secrets generated by Terraform: short name => length of the random value."
  type        = map(number)
  default = {
    "db-password" = 32
    "api-token"   = 48
  }
}

variable "accessors" {
  description = "Read access grants, keyed by a static name. The key must not depend on apply-time values."
  type = map(object({
    secret = string
    member = string
  }))
  default = {}
}
